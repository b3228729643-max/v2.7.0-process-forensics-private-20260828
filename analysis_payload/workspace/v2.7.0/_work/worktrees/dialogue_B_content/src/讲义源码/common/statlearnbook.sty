\newcommand{\SLAlgorithmCaptionContract}[1]{%
  % algorithm2e appends \endgraf inside the layout argument.  Letting that
  % paragraph break occur inside a LuaTeX link leaves the backend in vertical
  % mode before \pdfextension endlink.  Suppress it while the link is open,
  % then restore the required paragraph boundary after closing the link.
  \begingroup\let\endgraf\relax
    \leavevmode\hyperlink{SL:algorithm-contract}{#1}%
  \endgroup\endgraf
}

% Source-level mandatory contract for every numbered algorithm.  The actual
% reader-facing input/output/pseudocode and adjacent complexity prose remain
% in the chapter; this environment validates that all fourteen operational
% fields were considered without duplicating a long checklist in the PDF.
\newcommand{\SLAlgorithmContractReset}{%
  \def\SLACInput{}\def\SLACOutput{}\def\SLACPreconditions{}%
  \def\SLACInitialization{}\def\SLACLoop{}\def\SLACUpdate{}%
  \def\SLACDomain{}\def\SLACFailure{}\def\SLACStop{}%
  \def\SLACBudget{}\def\SLACStatus{}\def\SLACIterations{}%
  \def\SLACDiagnostics{}\def\SLACComplexity{}%
}
\pgfkeys{
  /SLAlgorithmContract/.is family,
  /SLAlgorithmContract,
  input/.store in=\SLACInput,
  output/.store in=\SLACOutput,
  preconditions/.store in=\SLACPreconditions,
  initialization/.store in=\SLACInitialization,
  loop/.store in=\SLACLoop,
  update/.store in=\SLACUpdate,
  domain/.store in=\SLACDomain,
  failure/.store in=\SLACFailure,
  stop/.store in=\SLACStop,
  budget/.store in=\SLACBudget,
  status/.store in=\SLACStatus,
  iterations/.store in=\SLACIterations,
  diagnostics/.store in=\SLACDiagnostics,
  complexity/.store in=\SLACComplexity,
  .unknown/.code={\PackageError{statlearnbook}{Unknown AlgorithmContract field '\pgfkeyscurrentname'}{Use exactly the fourteen v1.9.0 contract fields.}}
}
\newcommand{\SLAlgorithmContractRequire}[2]{%
  \ifdefempty{#2}{\PackageError{statlearnbook}{Empty required field: AlgorithmContract/#1}{Supply a specific value or an explicit not-applicable rationale.}}{}%
}
\newcommand{\SLAlgorithmContractRequireAll}{%
  \SLAlgorithmContractRequire{input}{\SLACInput}%
  \SLAlgorithmContractRequire{output}{\SLACOutput}%
  \SLAlgorithmContractRequire{preconditions}{\SLACPreconditions}%
  \SLAlgorithmContractRequire{initialization}{\SLACInitialization}%
  \SLAlgorithmContractRequire{loop}{\SLACLoop}%
  \SLAlgorithmContractRequire{update}{\SLACUpdate}%
  \SLAlgorithmContractRequire{domain}{\SLACDomain}%
  \SLAlgorithmContractRequire{failure}{\SLACFailure}%
  \SLAlgorithmContractRequire{stop}{\SLACStop}%
  \SLAlgorithmContractRequire{budget}{\SLACBudget}%
  \SLAlgorithmContractRequire{status}{\SLACStatus}%
  \SLAlgorithmContractRequire{iterations}{\SLACIterations}%
  \SLAlgorithmContractRequire{diagnostics}{\SLACDiagnostics}%
  \SLAlgorithmContractRequire{complexity}{\SLACComplexity}%
}
\NewDocumentEnvironment{AlgorithmContract}{m}{%
  \begingroup
  \SLAlgorithmContractReset
  \pgfkeys{/SLAlgorithmContract/.cd,#1}%
  \SLAlgorithmContractRequireAll
}{%
  \endgroup
}
\SetAlgoCaptionLayout{SLAlgorithmCaptionContract}

