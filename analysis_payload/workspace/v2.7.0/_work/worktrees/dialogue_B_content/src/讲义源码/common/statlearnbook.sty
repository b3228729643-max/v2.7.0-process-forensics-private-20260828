% A 10/7/5pt default math ladder makes nested subscripts and superscripts
% fall below the project's absolute 6pt PDF floor.  Preserve the normal text
% and display sizes while raising the script ladders used by the 11pt document
% class.  XeTeX's extracted PDF sizes are about 0.954 of the nominal math
% sizes, so a nominal 9pt ladder is required to clear the measured 8.5pt
% figure/algorithm gate.  Ordinary 10.95pt body math uses an 8pt deep-script
% floor, which clears the measured 7.5pt body gate without inflating prose.
\DeclareMathSizes{8.5}{9}{9}{9}
\DeclareMathSizes{9}{9.3}{9.3}{9.3}
\DeclareMathSizes{10}{10}{9}{9}
\DeclareMathSizes{10.95}{10.95}{9}{9}
% Wide TikZ figures are composed at 12pt before a bounded \resizebox; keep
% both math script levels large enough that rendered labels stay >=8.5pt.
\DeclareMathSizes{12}{12}{11.5}{11.5}

