\begin{theindex}

  \item $a$：单个实数, 1
  \item $A,B$：对象的无序汇集, 1
  \item $A,B$：随机事件, 47
  \item $A\in\R^{m\times n}$：从$\R^n$到$\R^m$的线性映射表示, 
		13

  \indexspace

  \item $B_k,G_k$：Hessian与逆Hessian近似, 116

  \indexspace

  \item $c_i(x),h_j(x)$：不等式约束与等式约束函数, 97

  \indexspace

  \item $D_{\boldsymbol{u}}f(\boldsymbol{x})$：单位方向$\boldsymbol{u}$上的方向导数, 
		31
  \item $d,\delta$：有限假设数与失败概率上限, 150
  \item $D_{\mathrm{KL}}(P\Vert Q)$：相对熵, 80

  \indexspace

  \item $f,\hat y$：预测函数与$\hat y=f(x)$, 169
  \item $f_\theta\ \text{或}\ P_\theta(Y\mid X)$：决策函数或条件概率分布, 
		134
  \item $f:\R^d\to\R$：输入向量、输出标量, 31
  \item $f:X\to Y$：把定义域中的每个元素指定到陪域中的唯一元素, 
		1
  \item $f(x)$：目标函数, 97

  \indexspace

  \item $H_f(\boldsymbol{x})$：二阶偏导组成的Hessian矩阵, 31
  \item $H(P,Q)$：用$Q$编码来自$P$的数据的交叉熵, 80
  \item $H(X),H(X\mid Y)$：熵与条件熵, 80

  \indexspace

  \item $I(x)$：事件结果$x$的自信息 $-\log p(x)$, 80
  \item $I(X;Y)$：互信息, 80

  \indexspace

  \item $J_{\boldsymbol g}(\boldsymbol{x})$：$[J_{\boldsymbol g}]_{ij}=\partial g_i/\partial x_j$, 
		31

  \indexspace

  \item $K,M$：交叉验证折数与候选配置数, 150

  \indexspace

  \item $L(\theta),\ell(\theta)$：似然与对数似然, 63
  \item $L,R$：损失与条件风险, 169
  \item $L(x,\alpha,\beta)$：拉格朗日函数, 97
  \item $L(y,f(x))$：预测$f(x)$相对真实输出$y$的损失, 150
  \item $L(y,f(x))$：单次预测的损失, 134

  \indexspace

  \item $\alpha_i,\beta_j$：拉格朗日乘子, 97
  \item $\alpha,\boldsymbol\alpha,\alpha_0$：标量形状参数、Dirichlet参数向量及总浓度, 
		63
  \item $\boldsymbol{g}:\R^d\to\R^m$：$m$个标量分量函数, 31
  \item $\boldsymbol{x},\boldsymbol{y}\in\R^n$：$n$个有序分量, 13
  \item $\boldsymbol{x}\in\R^d$：默认按列书写的向量, 1
  \item $\gamma,\ r_t,\ G_t$：折扣因子、即时奖励与累计回报，其中$0\le\gamma\le1$, 
		134
  \item $\ind\{P\}$：命题$P$成立取$1$，否则取$0$, 1
  \item $\inner{\boldsymbol{x},\boldsymbol{y}}$：$\boldsymbol{x}^{\mathsf T}\boldsymbol{y}$, 
		13
  \item $\lambda,J(f)$：正则化强度与复杂度函数, 150
  \item $\lambda,\boldsymbol{q}$：特征值与对应特征向量, 13
  \item $\mathbb E,\operatorname{Var},\operatorname{Cov}$：期望、方差、协方差, 
		47
  \item $\mathcal A$：本章学习框架中把训练数据和设定变为所选模型的学习算法；其他章可另作事件族或算子, 
		134
  \item $\mathcal F$：学习算法允许选择的假设空间, 134
  \item $\mathcal F$：候选模型或假设空间, 150
  \item $\mathcal X,\mathcal Y$：输入空间与输出空间, 169
  \item $\mathcal X,\mathcal Z,\mathcal Y$：输入空间、特征空间与输出空间, 
		134
  \item $\mathrm{TP},\mathrm{FP},\mathrm{FN},\mathrm{TN}$：二分类混淆矩阵四项计数, 
		169
  \item $\mathrm df$：函数的一阶微分, 31
  \item $\mu,\sigma^2,\Sigma$：均值、方差和协方差, 63
  \item $\nabla f(\boldsymbol{x})$：各偏导组成的列梯度, 31
  \item $\norm{\boldsymbol{x}}_2$：欧氏范数, 13
  \item $\Omega,\mathcal F,P$：概率空间, 47
  \item $\rank(A)$：行空间与列空间的共同维数, 13
  \item $\theta$：由学习过程确定并用于描述模型的量, 1
  \item $\theta\in\Theta$：具体模型的索引及其允许取值范围, 
		134
  \item $\theta,\Theta$：未知但固定的模型参数及其可行集合, 
		63
  \item $\varepsilon,c,\rho$：容差、充分下降常数与步长缩减因子, 
		116

  \indexspace

  \item $N(A)$：$A\boldsymbol{x}=\boldsymbol0$的全部解, 13

  \indexspace

  \item $p_k,\alpha_k$：搜索方向与步长, 116
  \item $p^*,d^*$：原问题与对偶问题最优值, 97
  \item $p_X,f_X,F_X$：概率质量、密度、分布函数, 47
  \item $P(X,Y)$：产生监督样本的总体统计规律, 134
  \item $p(y\mid x)$：给定输入时输出的条件概率, 169

  \indexspace

  \item $R(A)$：$A$的列空间，也就是$A$的值域, 13
  \item $R(f),\widehat R_N(f)$：期望风险与训练样本上的经验风险, 
		150
  \item $R(f),\widehat R_T(f)$：期望风险与经验风险, 134

  \indexspace

  \item $s_k,y_k$：$x_{k+1}-x_k$与$g_{k+1}-g_k$, 116

  \indexspace

  \item $T=\{(x_i,y_i)\}_{i=1}^{N}$：含$N$个输入--输出对的监督训练集, 
		134
  \item $T=\{(x_i,y_i)\}_{i=1}^N$：含$N$个标注样本的训练数据, 
		169
  \item $T=(z_1,\ldots,z_N)$：独立同分布训练样本, 150

  \indexspace

  \item $x_{1:n}$：$x_1,\ldots,x_n$ 的简写, 63
  \item $X_{1:n},Y_{1:n}$：长度$n$的观测序列与标记序列, 
		169
  \item $x_i,\,X_{ij}$：向量第$i$分量与矩阵第$i$行第$j$列分量, 
		1
  \item $x_k,g_k,H_k$：第$k$次迭代点、梯度与Hessian, 116
  \item $x\in\mathbb R^d$：待优化变量, 97
  \item $X\in\R^{n\times d}$：行对应样本、列对应特征的数据矩阵, 
		1
  \item $x,\phi(x),y$：一个实例、特征表示与输出值, 134
  \item $X,Y$：随机变量, 47
  \item $X,Y,Z$：输入、监督输出与潜在表示, 134

  \indexspace

  \item $Z=(X,Y)$：输入输出对，服从未知分布$P$, 150

\end{theindex}
