% The chapter source supplies the explicit, same-numbered answer heading.
% Ordinary worked answers are not proofs.  Every answer therefore starts with
% the same compact four-stage reading guide; the final stage may be omitted for
% a short exercise, while the domain/dimension checkpoint remains visible.
\newcommand{\SLSolutionStageGuide}{%
  \begingroup\footnotesize\color{SLTextGray}%
  \textbf{对象与条件}\enspace\textcolor{SLRuleGray}{$\blacktriangleright$}\enspace
  \textbf{推导}\enspace\textcolor{SLRuleGray}{$\blacktriangleright$}\enspace
  \textbf{结果核验（定义域/维数）}\enspace\textcolor{SLRuleGray}{$\blacktriangleright$}\enspace
  \textbf{解释（简单题可省）}%
  \endgroup
}
