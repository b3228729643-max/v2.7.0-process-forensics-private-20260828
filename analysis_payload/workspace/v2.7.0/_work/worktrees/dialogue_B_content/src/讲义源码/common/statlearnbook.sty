% R08 reader-facing structure ------------------------------------------------
% These interfaces deliberately require chapter-specific arguments.  Empty
% defaults would recreate the template-compliance problem they are meant to
% remove.
\newcommand{\SLRequireText}[2]{%
  \ifblank{#2}{\PackageError{statlearnbook}{Empty required field: #1}{Supply chapter-specific reader text.}}{}%
}
\newcommand{\SLChapterOpening}[5]{%
  \SLRequireText{route}{#1}\SLRequireText{question}{#2}%
  \SLRequireText{outcomes}{#3}\SLRequireText{prerequisites}{#4}%
  \SLRequireText{return-path}{#5}%
  \phantomsection\hypertarget{SL:chapter:\thechapter}{}%
  \global\SLFirstExampleAnchorPendingtrue
  \global\SLChapterMapPendingtrue
  \global\long\def\SLChapterRoute{#1}%
  \global\long\def\SLChapterQuestion{#2}%
  \global\long\def\SLChapterOutcomes{#3}%
  \global\long\def\SLChapterPrerequisites{#4}%
  \global\long\def\SLChapterReturnPath{#5}%
  \global\let\SLChapterGoalsDetail\@empty
  \global\let\SLChapterPrerequisiteDetail\@empty
  \global\let\SLChapterPrecheckDetail\@empty
  \global\let\SLChapterDependencyDetail\@empty
}
\newcommand{\SLRenderChapterMap}{%
  \ifSLChapterMapPending
  \begin{tcolorbox}[
    enhanced,breakable,colback=white,colframe=SLRuleGray,boxrule=0.45pt,
    title=本章地图,fonttitle=\bfseries,coltitle=SLDeepBlue,
    left=8pt,right=8pt,top=5pt,bottom=5pt,before skip=6pt,after skip=8pt]
    \small\setstretch{1.16}\setlength{\parskip}{0.10\baselineskip}%
    \textbf{核心问题：}\SLChapterQuestion\par
    \textbf{可检验学习目标：}%
      \ifdefempty{\SLChapterGoalsDetail}{\SLChapterOutcomes}{\SLChapterGoalsDetail}\par
    \textbf{最短先修：}%
      \ifdefempty{\SLChapterPrerequisiteDetail}{\SLChapterPrerequisites}{\SLChapterPrerequisiteDetail}\par
    \textbf{依赖路线：}%
      \ifdefempty{\SLChapterDependencyDetail}{\SLChapterRoute}{\SLChapterDependencyDetail}\par
    \textbf{完成标准与返回：}\SLChapterReturnPath
  \end{tcolorbox}%
  \global\SLChapterMapPendingfalse
  \else
    \PackageError{statlearnbook}{Chapter map rendered without a pending opening}{Call \string\SLChapterOpening before the legacy chapter-opening fields.}%
  \fi
}

\newcommand{\SLLevelSection}[3]{%
  \SLRequireText{section-level}{#1}\SLRequireText{section-title}{#2}\SLRequireText{section-label}{#3}%
  \ifboolexpr{
    test {\ifstrequal{#1}{直接应用}} or
    test {\ifstrequal{#1}{基础回顾}} or
    test {\ifstrequal{#1}{核心内容}} or
    test {\ifstrequal{#1}{扩展讨论}}
  }{}{\PackageError{statlearnbook}{Unknown section level '#1'}{Use 直接应用、基础回顾、核心内容 or 扩展讨论.}}%
  % Keep the prerequisite level as source-only metadata.  Reader-facing
  % headings, running heads, bookmarks and index-derived titles expose only
  % the pedagogical section title.
  \section{#2}\label{#3}%
}
\newcommand{\SLDirectSection}[2]{\SLLevelSection{直接应用}{#1}{#2}}
\newcommand{\SLReviewSection}[2]{\SLLevelSection{基础回顾}{#1}{#2}}
\newcommand{\SLTeachSection}[2]{\SLLevelSection{核心内容}{#1}{#2}}
\newcommand{\SLAdvancedSection}[2]{\SLLevelSection{扩展讨论}{#1}{#2}}

\newcommand{\SLNoIndependentAlgorithm}[1]{%
