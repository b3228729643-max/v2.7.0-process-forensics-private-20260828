}
\newcommand{\SLChapterFiveSummary}[5]{%
  \SLRequireText{summary-core-object}{#1}\SLRequireText{summary-derivation}{#2}%
  \SLRequireText{summary-algorithm}{#3}\SLRequireText{summary-when-to-use}{#4}%
  \SLRequireText{summary-next-step}{#5}%
  \begin{chaptersummarybox}[title=本章结论与下一步]
    \textbf{核心结论：}#1\par
    \textbf{关键依据：}#2\par
    \textbf{可执行自检：}#3\par
    \textbf{适用边界：}#4\par
    \textbf{下一步：}#5
  \end{chaptersummarybox}%
}

\newcommand{\SLRegisterRunningOccurrence}[2]{%
  \ifcsdef{SLRunOccurrence@#1@#2}{%
    \PackageError{statlearnbook}{Duplicate running-example occurrence '#1/#2'}{Use one globally unique occurrence-id for each series stop.}%
  }{\csdef{SLRunOccurrence@#1@#2}{registered}}%
}
\NewDocumentEnvironment{SLRunningExample}{mmmm}{%
  \SLRequireText{running-series-id}{#1}\SLRequireText{running-occurrence-id}{#2}%
  \SLRequireText{running-title}{#3}\SLRequireText{running-role}{#4}%
  \SLRegisterRunningOccurrence{#1}{#2}%
  \Needspace{6\baselineskip}% keep the heading and a meaningful first block together
  \begin{tcolorbox}[
    enhanced,breakable,colback=white,colframe=SLRuleGray,boxrule=0pt,
    borderline west={1.2pt}{0pt}{SLMidBlue},title={#3},fonttitle=\bfseries,
    coltitle=SLDeepBlue,left=8pt,right=8pt,top=5pt,bottom=5pt]
  \phantomsection\label{run:#1:#2}\textbf{本章角色：}#4\par
}{\end{tcolorbox}}
\newcommand{\SLRunningExampleRef}[3]{%
  \SLRequireText{running-series-id}{#1}\SLRequireText{running-occurrence-id}{#2}%
  \SLRequireText{running-link-text}{#3}%
  % A merged-book build resolves every stop as a hyperlink.  A stand-alone
  % volume deliberately falls back to readable text when the target lives in
  % another volume, avoiding a false or undefined PDF destination.
  \ifcsundef{r@run:#1:#2}{\textcolor{SLMidBlue}{#3}}{\hyperref[run:#1:#2]{#3}}%
}

